<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/widget_background">
<ImageView android:id="@+id/widget_art" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="centerCrop" android:src="@mipmap/spitify_launcher" android:contentDescription="Open Now Playing" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="14dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SPITIFY" android:textSize="10sp" android:textColor="#5CE095" android:letterSpacing="0.15" />
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready to listen" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your music, right here" android:textSize="12sp" android:textColor="#B7C7BF" android:maxLines="1" android:ellipsize="end" />
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
<ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:background="@android:color/transparent" android:src="@drawable/widget_previous" android:contentDescription="Previous" /><ImageButton android:id="@+id/widget_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:background="@android:color/transparent" android:src="@drawable/widget_play" android:contentDescription="Play" /><ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:background="@android:color/transparent" android:src="@drawable/widget_next" android:contentDescription="Next" /></LinearLayout></LinearLayout></LinearLayout>